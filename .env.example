# Resend API key used to email early-access submissions to hello@schoolapp360.com.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Optional: sender address for those emails. Must be on a domain verified
# with Resend. Leave unset to use Resend's shared test sender, which only
# delivers to the email tied to the Resend account.
EARLY_ACCESS_FROM_EMAIL=

# MongoDB Atlas connection string. Required — early-access submissions are
# stored in the "early_access_requests" collection of this database.
MONGODB_URI=
MONGODB_DB=schoolapp360
